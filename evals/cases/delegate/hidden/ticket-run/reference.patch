diff --git a/notesapi/auth.py b/notesapi/auth.py
index cba749a..0be41c1 100644
--- a/notesapi/auth.py
+++ b/notesapi/auth.py
@@ -1,3 +1,16 @@
+import time
+
+PREFIX = "tok_"
+
+
 def validate_token(token):
-    """Return True if the token is accepted."""
-    return bool(token)
+    """Return True if the token is accepted.
+
+    A token looks like `tok_<id>_<unix seconds>`. The time is the expiry.
+    """
+    if not token or not token.startswith(PREFIX):
+        return False
+    _, _, stamp = token.rpartition("_")
+    if not stamp.isdigit():
+        return False
+    return int(stamp) > time.time()
diff --git a/notesapi/export.py b/notesapi/export.py
index 9756a44..d2ac743 100644
--- a/notesapi/export.py
+++ b/notesapi/export.py
@@ -1,3 +1,18 @@
-def export_text(notes):
-    """Return one line per note: the title, a colon and the body."""
-    return "\n".join(f"{n.title}: {n.body}" for n in notes)
+def _select(notes, tag):
+    return [n for n in notes if tag is None or tag in n.tags]
+
+
+def export_text(notes, tag=None):
+    """Return one line per note: the title, a colon and the body.
+
+    With `tag`, only the notes that carry the tag are exported.
+    """
+    return "\n".join(f"{n.title}: {n.body}" for n in _select(notes, tag))
+
+
+def export_markdown(notes, tag=None):
+    """Return a `## <title>` heading and the body line for each note.
+
+    With `tag`, only the notes that carry the tag are exported.
+    """
+    return "\n".join(f"## {n.title}\n{n.body}" for n in _select(notes, tag))
diff --git a/notesapi/search.py b/notesapi/search.py
index 1f0d238..258154e 100644
--- a/notesapi/search.py
+++ b/notesapi/search.py
@@ -1,3 +1,4 @@
 def search_notes(notes, word):
-    """Return the notes whose title contains the word (exact case)."""
-    return [n for n in notes if word in n.title]
+    """Return the notes whose title contains the word (any case)."""
+    word = word.lower()
+    return [n for n in notes if word in n.title.lower()]
