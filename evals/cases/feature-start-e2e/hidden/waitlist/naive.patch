diff --git a/allotment/core/waitlist.py b/allotment/core/waitlist.py
new file mode 100644
index 0000000..1a9972a
--- /dev/null
+++ b/allotment/core/waitlist.py
@@ -0,0 +1,36 @@
+"""Waitlist for plots that are taken for a season."""
+from allotment import clock
+from allotment.core.errors import NotFound
+from allotment.worker import queue
+
+
+def join(conn, plot_id, member_id, season):
+    cur = conn.execute(
+        "INSERT INTO waitlist_entries (plot_id, member_id, season, "
+        "joined_at) VALUES (?, ?, ?, ?)",
+        (plot_id, member_id, season, clock.now()))
+    return cur.lastrowid
+
+
+def leave(conn, entry_id):
+    cur = conn.execute("DELETE FROM waitlist_entries WHERE id = ?",
+                       (entry_id,))
+    if cur.rowcount == 0:
+        raise NotFound(f"waitlist entry {entry_id}")
+
+
+def promote_next(conn, cancelled):
+    """Give the cancelled booking's plot to the first member in line."""
+    row = conn.execute(
+        "SELECT * FROM waitlist_entries WHERE plot_id = ? AND season = ? "
+        "ORDER BY joined_at, id LIMIT 1",
+        (cancelled.plot_id, cancelled.season)).fetchone()
+    if row is None:
+        return None
+    cur = conn.execute(
+        "INSERT INTO bookings (plot_id, member_id, season, status, "
+        "price_cents, created_at) VALUES (?, ?, ?, 'active', ?, ?)",
+        (cancelled.plot_id, row["member_id"], cancelled.season,
+         cancelled.price_cents, clock.now()))
+    queue.enqueue(conn, "waitlist.promoted", {"booking_id": cur.lastrowid})
+    return cur.lastrowid
