diff --git a/allotment/core/waitlist.py b/allotment/core/waitlist.py
new file mode 100644
index 0000000..6975ee2
--- /dev/null
+++ b/allotment/core/waitlist.py
@@ -0,0 +1,52 @@
+"""Waitlist for plots that are taken for a season.
+
+When a booking is cancelled, promote_next() books the plot for the first
+member in line (at that member's own price), marks the entry promoted and
+queues the message as a worker job.
+"""
+import sqlite3
+
+from allotment import clock
+from allotment.core import bookings, members, plots
+from allotment.core.errors import Invalid, NotFound
+from allotment.worker import queue
+
+PROMOTED_JOB = "waitlist.promoted"
+
+
+def join(conn, plot_id, member_id, season):
+    plots.get(conn, plot_id)
+    members.get(conn, member_id)
+    if bookings.active(conn, plot_id, season) is None:
+        raise Invalid("the plot is free for that season: book it instead")
+    try:
+        cur = conn.execute(
+            "INSERT INTO waitlist_entries (plot_id, member_id, season, "
+            "joined_at) VALUES (?, ?, ?, ?)",
+            (plot_id, member_id, season, clock.now()))
+    except sqlite3.IntegrityError:
+        raise Invalid("already in line for that plot and season") from None
+    return cur.lastrowid
+
+
+def leave(conn, entry_id):
+    cur = conn.execute("DELETE FROM waitlist_entries WHERE id = ? AND "
+                       "promoted_at IS NULL", (entry_id,))
+    if cur.rowcount == 0:
+        raise NotFound(f"waitlist entry {entry_id}")
+
+
+def promote_next(conn, plot_id, season):
+    """Book the plot for the first member in line never promoted before;
+    return the booking, or None when nobody is waiting."""
+    row = conn.execute(
+        "SELECT * FROM waitlist_entries WHERE plot_id = ? AND season = ? "
+        "AND promoted_at IS NULL ORDER BY joined_at, id LIMIT 1",
+        (plot_id, season)).fetchone()
+    if row is None:
+        return None
+    booking = bookings.book(conn, plot_id, row["member_id"], season)
+    conn.execute("UPDATE waitlist_entries SET promoted_at = ? WHERE id = ?",
+                 (clock.now(), row["id"]))
+    queue.enqueue(conn, PROMOTED_JOB, {"booking_id": booking.id})
+    return booking
