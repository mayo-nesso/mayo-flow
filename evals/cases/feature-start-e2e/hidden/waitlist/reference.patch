diff --git a/allotment/worker/waitlist.py b/allotment/worker/waitlist.py
new file mode 100644
index 0000000..bf75eae
--- /dev/null
+++ b/allotment/worker/waitlist.py
@@ -0,0 +1,18 @@
+"""Tell a member they got a plot from the waitlist."""
+from allotment.core import bookings, members, plots
+
+
+def send_promoted(conn, payload, outbox):
+    """Queue the waitlist_promoted message; members without email get none."""
+    booking = bookings.get(conn, payload["booking_id"])
+    member = members.get(conn, booking.member_id)
+    if not member.email:
+        return 0
+    outbox.append({
+        "to": member.email,
+        "template": "waitlist_promoted",
+        "vars": {"name": member.name,
+                 "plot": plots.get(conn, booking.plot_id).code,
+                 "season": booking.season},
+    })
+    return 1
diff --git a/migrations/0005_waitlist.sql b/migrations/0005_waitlist.sql
new file mode 100644
index 0000000..3609d29
--- /dev/null
+++ b/migrations/0005_waitlist.sql
@@ -0,0 +1,11 @@
+CREATE TABLE waitlist_entries (
+    id INTEGER PRIMARY KEY,
+    plot_id INTEGER NOT NULL REFERENCES plots (id),
+    member_id INTEGER NOT NULL REFERENCES members (id),
+    season TEXT NOT NULL,
+    joined_at TEXT NOT NULL,
+    promoted_at TEXT,
+    UNIQUE (plot_id, member_id, season)
+);
+
+CREATE INDEX waitlist_line ON waitlist_entries (plot_id, season, joined_at, id);
diff --git a/tests/test_waitlist.py b/tests/test_waitlist.py
new file mode 100644
index 0000000..b753f0d
--- /dev/null
+++ b/tests/test_waitlist.py
@@ -0,0 +1,64 @@
+from allotment import clock
+from allotment.api.routes import dispatch
+from allotment.core import bookings, waitlist
+from allotment.core.errors import Invalid, NotFound
+from allotment.worker import queue, runner
+from tests.helpers import DbCase
+
+SEASON = "spring-2027"
+
+
+class WaitlistTest(DbCase):
+    def setUp(self):
+        super().setUp()
+        self.p = self.plot()
+        self.a = self.member("Ana")
+        self.b = self.member("Bo", email="bo@example.org")
+        self.c = self.member("Cy", email="cy@example.org")
+        self.booking = bookings.book(self.conn, self.p.id, self.a.id, SEASON)
+
+    def join(self, member, at):
+        clock.freeze(at)
+        return waitlist.join(self.conn, self.p.id, member.id, SEASON)
+
+    def test_join_a_free_plot_or_twice_is_refused(self):
+        other = self.plot("B2")
+        with self.assertRaises(Invalid):
+            waitlist.join(self.conn, other.id, self.b.id, SEASON)
+        self.join(self.b, "2027-02-02T09:00:00+00:00")
+        with self.assertRaises(Invalid):
+            self.join(self.b, "2027-02-03T09:00:00+00:00")
+
+    def test_first_in_line_is_promoted_once(self):
+        self.join(self.b, "2027-02-02T09:00:00+00:00")
+        self.join(self.c, "2027-02-03T09:00:00+00:00")
+        bookings.cancel(self.conn, self.booking.id)
+        first = waitlist.promote_next(self.conn, self.p.id, SEASON)
+        self.assertEqual(first.member_id, self.b.id)
+        bookings.cancel(self.conn, first.id)
+        second = waitlist.promote_next(self.conn, self.p.id, SEASON)
+        self.assertEqual(second.member_id, self.c.id)
+
+    def test_leave(self):
+        e = self.join(self.b, "2027-02-02T09:00:00+00:00")
+        waitlist.leave(self.conn, e)
+        with self.assertRaises(NotFound):
+            waitlist.leave(self.conn, e)
+        bookings.cancel(self.conn, self.booking.id)
+        self.assertIsNone(waitlist.promote_next(self.conn, self.p.id, SEASON))
+
+    def test_api_cancel_promotes_and_notifies(self):
+        status, _ = dispatch(self.conn, "POST", "/waitlist", {
+            "plot_id": self.p.id, "member_id": self.b.id, "season": SEASON})
+        self.assertEqual(status, 201)
+        status, _ = dispatch(self.conn, "DELETE",
+                             f"/bookings/{self.booking.id}")
+        self.assertEqual(status, 200)
+        outbox = []
+        runner.drain(self.conn, outbox)
+        (msg,) = outbox
+        self.assertEqual((msg["to"], msg["template"]),
+                         ("bo@example.org", "waitlist_promoted"))
+        self.assertEqual(queue.counts(self.conn), {"done": 1})
+        _, body = dispatch(self.conn, "GET", f"/members/{self.b.id}/bookings")
+        self.assertEqual([b["status"] for b in body["bookings"]], ["active"])
